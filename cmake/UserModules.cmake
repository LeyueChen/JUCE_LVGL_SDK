# Each immediate user/<module>/CMakeLists.txt owns its source list and declares
# SDK_USER_MODULE_TARGET as a DIRECTORY property. No global source/include glob.
include_guard(GLOBAL)
function(sdk_add_user_modules aggregate)
    add_library(${aggregate} INTERFACE)
    file(GLOB module_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*/CMakeLists.txt")
    if(NOT module_files)
        message(FATAL_ERROR "No user modules found in ${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    set(exports "")
    foreach(module_file IN LISTS module_files)
        get_filename_component(module_dir "${module_file}" DIRECTORY)
        get_filename_component(module_name "${module_dir}" NAME)
        add_subdirectory("${module_dir}" "${CMAKE_CURRENT_BINARY_DIR}/${module_name}")
        get_property(registered DIRECTORY "${module_dir}" PROPERTY SDK_USER_MODULE_TARGET SET)
        if(NOT registered)
            message(FATAL_ERROR "${module_name}: set DIRECTORY property SDK_USER_MODULE_TARGET to the module target(s), or an empty string for a disabled module")
        endif()
        get_property(module_targets DIRECTORY "${module_dir}" PROPERTY SDK_USER_MODULE_TARGET)
        list(APPEND exports ${module_targets})
    endforeach()
    foreach(module_target IN LISTS exports)
        if(NOT TARGET ${module_target})
            message(FATAL_ERROR "Unknown user module target: ${module_target}")
        endif()
    endforeach()
    target_link_libraries(${aggregate} INTERFACE ${exports})
endfunction()
