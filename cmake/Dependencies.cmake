file(READ "${CMAKE_SOURCE_DIR}/third_party/deps.lock.json" SDK_LOCK)
string(JSON SDK_DEP_COUNT LENGTH "${SDK_LOCK}" dependencies)
math(EXPR SDK_DEP_LAST "${SDK_DEP_COUNT} - 1")
foreach(index RANGE 0 ${SDK_DEP_LAST})
    string(JSON name GET "${SDK_LOCK}" dependencies ${index} name)
    string(JSON revision GET "${SDK_LOCK}" dependencies ${index} commit)
    string(TOUPPER "${name}" upper)
    set(SDK_${upper}_DIR "${CMAKE_SOURCE_DIR}/.cache/sources/${name}-${revision}")
endforeach()
foreach(name JUCE FREERTOS LVGL)
    if(NOT IS_DIRECTORY "${SDK_${name}_DIR}")
        message(FATAL_ERROR "Missing ${name}. Run tools/sdk.ps1 sync first.")
    endif()
endforeach()
foreach(component cjson littlefs flashdb nanopb multibutton easylogger rtneural)
    string(TOUPPER "${component}" upper)
    if(CONFIG_SDK_${upper} STREQUAL "y" AND NOT IS_DIRECTORY "${SDK_${upper}_DIR}")
        message(FATAL_ERROR "Missing enabled component ${component}. Run tools/sdk.ps1 sync.")
    endif()
endforeach()

configure_file(sdk/config/freertos/FreeRTOSConfig.h.in "${SDK_GENERATED_DIR}/FreeRTOSConfig.h" COPYONLY)
configure_file(sdk/config/lvgl/lv_conf.h.in "${SDK_GENERATED_DIR}/lv_conf.h" COPYONLY)
configure_file(sdk/config/flashdb/fdb_cfg.h.in "${SDK_GENERATED_DIR}/fdb_cfg.h" COPYONLY)
configure_file(sdk/config/easylogger/elog_cfg.h.in "${SDK_GENERATED_DIR}/elog_cfg.h" COPYONLY)

# Explicit, checked overlay: upstream source cache stays pristine.
file(READ "${SDK_FREERTOS_DIR}/portable/MSVC-MingW/port.c" port_source)
string(REGEX MATCHALL "SetThreadAffinityMask\\([^;]+" affinity_sites "${port_source}")
list(LENGTH affinity_sites affinity_count)
if(NOT affinity_count EQUAL 3)
    message(FATAL_ERROR "FreeRTOS port changed: expected exactly three affinity sites; review patch")
endif()
string(REPLACE "SetThreadAffinityMask( pxThreadState->pvThread, 0x01 );" "sdk_win_bind_thread( pxThreadState->pvThread );" port_source "${port_source}")
string(REPLACE "SetThreadAffinityMask( pvHandle, 0x01 );" "sdk_win_bind_thread( pvHandle );" port_source "${port_source}")
if(port_source MATCHES "SetThreadAffinityMask")
    message(FATAL_ERROR "FreeRTOS affinity overlay did not replace all sites")
endif()
set(patched_port "extern void sdk_win_bind_thread(void *thread);\n${port_source}")
set(old_port "")
if(EXISTS "${SDK_GENERATED_DIR}/freertos_port.c")
    file(READ "${SDK_GENERATED_DIR}/freertos_port.c" old_port)
endif()
if(NOT old_port STREQUAL patched_port)
    file(WRITE "${SDK_GENERATED_DIR}/freertos_port.c" "${patched_port}")
endif()
add_library(sdk_freertos STATIC
    "${SDK_FREERTOS_DIR}/tasks.c" "${SDK_FREERTOS_DIR}/queue.c"
    "${SDK_FREERTOS_DIR}/list.c" "${SDK_FREERTOS_DIR}/timers.c"
    "${SDK_FREERTOS_DIR}/event_groups.c" "${SDK_FREERTOS_DIR}/stream_buffer.c"
    "${SDK_FREERTOS_DIR}/portable/MemMang/heap_4.c" "${SDK_GENERATED_DIR}/freertos_port.c")
target_include_directories(sdk_freertos PUBLIC "${SDK_GENERATED_DIR}" "${SDK_FREERTOS_DIR}/include" "${SDK_FREERTOS_DIR}/portable/MSVC-MingW")
target_link_libraries(sdk_freertos PUBLIC winmm)

