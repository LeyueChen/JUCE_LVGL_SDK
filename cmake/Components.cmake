if(CONFIG_SDK_MULTIBUTTON STREQUAL "y")
    # The upstream header defines constants unconditionally. Copy both files to
    # the build tree so its local include also resolves the SDK-configured header.
    set(button_dir "${SDK_GENERATED_DIR}/multibutton")
    file(MAKE_DIRECTORY "${button_dir}")
    file(READ "${SDK_MULTIBUTTON_DIR}/multi_button.h" button_header)
    foreach(pair "TICKS_INTERVAL|CONFIG_SDK_BUTTON_SCAN_MS" "DEBOUNCE_TICKS|CONFIG_SDK_BUTTON_DEBOUNCE_TICKS" "SHORT_TICKS|(CONFIG_SDK_BUTTON_CLICK_MS / TICKS_INTERVAL)" "LONG_TICKS|(CONFIG_SDK_BUTTON_LONG_MS / TICKS_INTERVAL)")
        string(REPLACE "|" ";" mapping "${pair}")
        list(GET mapping 0 symbol)
        list(GET mapping 1 value)
        string(REGEX MATCHALL "#define ${symbol}[^\n]+" sites "${button_header}")
        list(LENGTH sites count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "MultiButton configuration changed; review ${symbol}")
        endif()
        string(REGEX REPLACE "#define ${symbol}[^\n]+" "#define ${symbol} ${value}" button_header "${button_header}")
    endforeach()
    set(button_header "#include \"sdk_config.h\"\n${button_header}")
    set(old_button_header "")
    if(EXISTS "${button_dir}/multi_button.h")
        file(READ "${button_dir}/multi_button.h" old_button_header)
    endif()
    if(NOT old_button_header STREQUAL button_header)
        file(WRITE "${button_dir}/multi_button.h" "${button_header}")
    endif()
    configure_file("${SDK_MULTIBUTTON_DIR}/multi_button.c" "${button_dir}/multi_button.c" COPYONLY)
    add_library(sdk_multibutton STATIC "${button_dir}/multi_button.c")
    target_include_directories(sdk_multibutton PUBLIC "${button_dir}" "${SDK_GENERATED_DIR}")
    target_link_libraries(sdk_components INTERFACE sdk_multibutton)
endif()
