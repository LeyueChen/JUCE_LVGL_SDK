# Curated APIs only. Chip-specific assembly stays in target SDKs.
if(CONFIG_SDK_ESP_DSP_REF STREQUAL "y")
    if(NOT IS_DIRECTORY "${SDK_ESP_DSP_DIR}")
        message(FATAL_ERROR "Missing ESP-DSP. Run tools/sdk.ps1 sync.")
    endif()
    add_library(sdk_esp_dsp_ref STATIC "${SDK_ESP_DSP_DIR}/modules/dotprod/float/dsps_dotprod_f32_ansi.c")
    target_include_directories(sdk_esp_dsp_ref PUBLIC
        "${SDK_ESP_DSP_DIR}/modules/dotprod/include"
        "${SDK_ESP_DSP_DIR}/modules/common/include"
        "${SDK_ESP_DSP_DIR}/modules/common/include_sim")
    target_link_libraries(sdk_components INTERFACE sdk_esp_dsp_ref)
endif()
if(CONFIG_SDK_ESP_NN_REF STREQUAL "y")
    if(NOT IS_DIRECTORY "${SDK_ESP_NN_DIR}")
        message(FATAL_ERROR "Missing ESP-NN. Run tools/sdk.ps1 sync.")
    endif()
    file(READ "${SDK_ESP_NN_DIR}/src/common/common_functions.h" nn_common)
    string(REPLACE "__attribute((always_inline)) static inline" "static inline" nn_common "${nn_common}")
    file(MAKE_DIRECTORY "${SDK_GENERATED_DIR}/esp_nn")
    set(nn_prefix "#include <stdint.h>\n#ifdef _MSC_VER\nstatic inline int32_t sdk_nn_max_i32(int32_t a, int32_t b) { return a > b ? a : b; }\nstatic inline int32_t sdk_nn_min_i32(int32_t a, int32_t b) { return a < b ? a : b; }\n#define max(a,b) sdk_nn_max_i32((a),(b))\n#define min(a,b) sdk_nn_min_i32((a),(b))\n#endif\n")
    set(nn_patched "${nn_prefix}${nn_common}")
    set(nn_old "")
    if(EXISTS "${SDK_GENERATED_DIR}/esp_nn/common_functions.h")
        file(READ "${SDK_GENERATED_DIR}/esp_nn/common_functions.h" nn_old)
    endif()
    if(NOT nn_old STREQUAL nn_patched)
        file(WRITE "${SDK_GENERATED_DIR}/esp_nn/common_functions.h" "${nn_patched}")
    endif()
    add_library(sdk_esp_nn_ref STATIC "${SDK_ESP_NN_DIR}/src/activation_functions/esp_nn_relu_ansi.c")
    target_include_directories(sdk_esp_nn_ref PRIVATE "${SDK_GENERATED_DIR}/esp_nn")
    target_link_libraries(sdk_components INTERFACE sdk_esp_nn_ref)
endif()
add_library(sdk_algorithms STATIC sdk/adapters/esp/reference.c)
target_include_directories(sdk_algorithms PUBLIC sdk/include "${SDK_GENERATED_DIR}")
if(TARGET sdk_esp_dsp_ref)
    target_link_libraries(sdk_algorithms PRIVATE sdk_esp_dsp_ref)
endif()
if(TARGET sdk_esp_nn_ref)
    target_link_libraries(sdk_algorithms PRIVATE sdk_esp_nn_ref)
endif()
target_link_libraries(sdk_components INTERFACE sdk_algorithms)
