#include <stdint.h>
#include "sdk_config.h"
#ifdef __cplusplus
extern "C" {
#endif
void sdk_port_assert(const char *file, int line);
uint32_t sdk_port_runtime_counter(void);
#ifdef __cplusplus
}
#endif
#define configASSERT(x)                                      \
	do {                                                 \
		if (!(x))                                    \
			sdk_port_assert(__FILE__, __LINE__); \
	} while (0)
