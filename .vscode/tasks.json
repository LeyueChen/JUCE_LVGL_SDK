{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SDK: build",
      "type": "shell",
      "command": "${workspaceFolder}/sdk.cmd",
      "args": [
        "build",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "${env:ComSpec}",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
