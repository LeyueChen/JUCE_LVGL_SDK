{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SDK: build",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "build",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "SDK: clean",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "clean",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: run",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "run",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SDK: test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "test",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "SDK: configure",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "configure",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: workspace",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "workspace",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: menuconfig",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "menuconfig",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: sync",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: format",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "format"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SDK: device settings",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "run",
        "--project",
        "${command:cpptools.activeConfigName}",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}",
        "--show-devices"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "SDK: refresh projects",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/sdk.py",
        "refresh-projects",
        "--board",
        "${config:sdk.board}",
        "--config",
        "${config:sdk.configuration}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
